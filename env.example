# Langfuse tracing (auto-uploaded from each run)
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# HuggingFace router: required for downloading gated model weights (e.g. Qwen3.5-122B-A10B-FP8)
HF_TOKEN="hf_..."

# API backends (only the one you use with --backend api --api-model ... is required)
OPENAI_API_KEY="sk-proj-..."
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_API_KEY="..."  # Get from https://aistudio.google.com/apikey
