export PROJECT_ROOT=$(expand_path .)

# Load .env file if it exists
dotenv_if_exists

use flake

# layout uv
# based on https://github.com/direnv/direnv/pull/1352
watch_file .python-version pyproject.toml uv.lock
uv sync
source_env .venv/bin/activate

export MATPLOTLIBRC=$(expand_path matplotlibrc)
